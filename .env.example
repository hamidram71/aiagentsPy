# ---- which model -----------------------------------------------------------
# openai | anthropic | fake
LLM_PROVIDER=openai
# LLM_MODEL=gpt-6-luna          # cheapest OpenAI chat model
# LLM_MODEL=claude-sonnet-5
# 0 = as repeatable as the model allows. Leave it BLANK (LLM_TEMPERATURE=)
# to send no temperature at all -- some newer models accept only their own
# default and answer an explicit 0 with a 400. The code recovers from that
# by itself on the first call; setting it blank skips the warning.
LLM_TEMPERATURE=0

OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ---- graph behaviour -------------------------------------------------------
# NOTE: every key must appear only ONCE in this file. python-dotenv keeps the
# LAST assignment, silently, so a duplicated key means the value you edited
# further up has no effect at all.
REQUIRE_APPROVAL=true     # pause for human approval of the plan (true/false, ja/nein)
REQUIRE_CHART=true        # every report with findings gets at least one chart
MAX_FAILURES=3            # total node failures tolerated per run
MAX_STEPS=30              # model turns per run (supervisor + workers)
MAX_TOOL_ROUNDS=4         # turns a worker gets for ONE plan step
LLM_TIMEOUT=120           # seconds to wait for one model request
CHECKPOINT_DB=outputs/checkpoints.sqlite   # ':memory:' to disable persistence

# ---- web app (python run_app.py) ------------------------------------------
# Blank: the app is reachable from THIS computer only.
# Set (8+ characters): colleagues on the office network can open it, and
# must type this password. Give it to them in person, not by e-mail.
APP_PASSWORD=
# Where runs, reports, charts and usage.csv are written (default: outputs/).
# OUTPUT_DIR=D:/Analysen/csv-agent

# ---- sandbox ---------------------------------------------------------------
CODE_TIMEOUT=15           # seconds per generated pandas snippet
MAX_ROWS_TO_MODEL=20      # rows a tool may show the model

# نام مدل‌ها با زمان عوض می‌شود. اگر خطای "model not found" گرفتید،
# لیست فعلی provider را چک کنید و LLM_MODEL را دستی ست کنید.
